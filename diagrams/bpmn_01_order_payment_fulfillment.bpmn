<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="B1_Definitions" targetNamespace="https://sme-o2c.example/bpmn" exporter="IT4350 SME O2C">
  <bpmn:message id="B1_Message_1" name="Đơn hàng"/>
  <bpmn:message id="B1_Message_2" name="Yêu cầu tạo QR"/>
  <bpmn:message id="B1_Message_3" name="Mã QR và tham chiếu"/>
  <bpmn:message id="B1_Message_4" name="Mã QR cho khách"/>
  <bpmn:message id="B1_Message_5" name="Kết quả thanh toán QR"/>
  <bpmn:message id="B1_Message_6" name="Yêu cầu vận đơn và số COD"/>
  <bpmn:message id="B1_Message_7" name="Mã vận đơn"/>
  <bpmn:message id="B1_Message_8" name="Kết quả giao và số COD"/>
  <bpmn:collaboration id="B1_Collaboration" name="BPMN-01 — Đặt đơn, thanh toán và giao hàng">
    <bpmn:participant id="B1_shop" name="Shop SME" processRef="B1_Process"/>
    <bpmn:participant id="B1_buyer" name="Khách hàng"/>
    <bpmn:participant id="B1_qr" name="Ngân hàng/Đơn vị cung cấp thanh toán QR"/>
    <bpmn:participant id="B1_carrier" name="Đơn vị vận chuyển"/>
    <bpmn:messageFlow id="B1_MsgFlow_1" name="Đơn hàng" sourceRef="B1_buyer" targetRef="B1_start"/>
    <bpmn:messageFlow id="B1_MsgFlow_2" name="Yêu cầu tạo QR" sourceRef="B1_requestQr" targetRef="B1_qr"/>
    <bpmn:messageFlow id="B1_MsgFlow_3" name="Mã QR và tham chiếu" sourceRef="B1_qr" targetRef="B1_gotQr"/>
    <bpmn:messageFlow id="B1_MsgFlow_4" name="Mã QR cho khách" sourceRef="B1_showQr" targetRef="B1_buyer"/>
    <bpmn:messageFlow id="B1_MsgFlow_5" name="Kết quả thanh toán QR" sourceRef="B1_qr" targetRef="B1_paid"/>
    <bpmn:messageFlow id="B1_MsgFlow_6" name="Yêu cầu vận đơn và số COD" sourceRef="B1_shipRequest" targetRef="B1_carrier"/>
    <bpmn:messageFlow id="B1_MsgFlow_7" name="Mã vận đơn" sourceRef="B1_carrier" targetRef="B1_tracking"/>
    <bpmn:messageFlow id="B1_MsgFlow_8" name="Kết quả giao và số COD" sourceRef="B1_carrier" targetRef="B1_delivery"/>
  </bpmn:collaboration>
  <bpmn:process id="B1_Process" name="BPMN-01 — Đặt đơn, thanh toán và giao hàng" isExecutable="false">
    <bpmn:laneSet id="B1_LaneSet">
      <bpmn:lane id="B1_Lane_order" name="Tiếp nhận đơn">
        <bpmn:flowNodeRef>B1_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B1_Lane_stock" name="Kho">
        <bpmn:flowNodeRef>B1_reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_stockOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_noStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B1_Lane_pay" name="Thanh toán">
        <bpmn:flowNodeRef>B1_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_expected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_requestQr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_gotQr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_showQr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_waitQr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_endExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_postQr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B1_Lane_ship" name="Điều phối vận chuyển">
        <bpmn:flowNodeRef>B1_shipRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_deliveryOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_recordGood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_endGood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_recordBad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_endBad</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="B1_Object_Order" name="Order (đơn hàng)"/>
    <bpmn:dataObjectReference id="B1_Data_Order" name="Order (đơn hàng)" dataObjectRef="B1_Object_Order"/>
    <bpmn:dataObject id="B1_Object_Reservation" name="Reservation (giữ chỗ)"/>
    <bpmn:dataObjectReference id="B1_Data_Reservation" name="Reservation (giữ chỗ)" dataObjectRef="B1_Object_Reservation"/>
    <bpmn:dataObject id="B1_Object_Shipment" name="Shipment (vận đơn)"/>
    <bpmn:dataObjectReference id="B1_Data_Shipment" name="Shipment (vận đơn)" dataObjectRef="B1_Object_Shipment"/>
    <bpmn:dataObject id="B1_Object_ShipmentEvent" name="ShipmentEvent (lần giao)"/>
    <bpmn:dataObjectReference id="B1_Data_ShipmentEvent" name="ShipmentEvent (lần giao)" dataObjectRef="B1_Object_ShipmentEvent"/>
    <bpmn:dataObject id="B1_Object_PaymentEntry" name="PaymentEntry (QR đã trả)"/>
    <bpmn:dataObjectReference id="B1_Data_PaymentEntry" name="PaymentEntry (QR đã trả)" dataObjectRef="B1_Object_PaymentEntry"/>
    <bpmn:startEvent id="B1_start" name="Đã nhận đơn">
      <bpmn:outgoing>B1_Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B1_EventDef_start" messageRef="B1_Message_1"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B1_validate" name="Kiểm tra và ghi đơn">
      <bpmn:incoming>B1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_2</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B1_IO_Order" name="Order (đơn hàng)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B1_IO_Order</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B1_DataAssoc_1"><bpmn:sourceRef>B1_IO_Order</bpmn:sourceRef><bpmn:targetRef>B1_Data_Order</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B1_reserve" name="Kiểm tra và giữ hàng">
      <bpmn:incoming>B1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_3</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B1_IO_Reservation" name="Reservation (giữ chỗ)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B1_IO_Reservation</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B1_DataAssoc_2"><bpmn:sourceRef>B1_IO_Reservation</bpmn:sourceRef><bpmn:targetRef>B1_Data_Reservation</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B1_stockOk" name="Giữ hàng được?" default="B1_Flow_5">
      <bpmn:incoming>B1_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>B1_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B1_noStock" name="Đơn hết tồn">
      <bpmn:incoming>B1_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="B1_method" name="Phương thức thanh toán?">
      <bpmn:incoming>B1_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>B1_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B1_expected" name="Ghi số COD dự kiến thu">
      <bpmn:incoming>B1_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B1_requestQr" name="Yêu cầu tạo mã QR" messageRef="B1_Message_2">
      <bpmn:incoming>B1_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="B1_gotQr" name="Đã nhận mã QR">
      <bpmn:incoming>B1_Flow_9</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B1_EventDef_gotQr" messageRef="B1_Message_3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="B1_showQr" name="Hiển thị QR cho khách" messageRef="B1_Message_4">
      <bpmn:incoming>B1_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="B1_waitQr" name="Chờ thanh toán hoặc hết hạn">
      <bpmn:incoming>B1_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>B1_Flow_13</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="B1_paid" name="Đã xác nhận thanh toán QR">
      <bpmn:incoming>B1_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B1_EventDef_paid" messageRef="B1_Message_5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="B1_expired" name="Hết hạn QR">
      <bpmn:incoming>B1_Flow_13</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B1_EventDef_expired"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">qrExpiresAt</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="B1_cancel" name="Hủy đơn và giải phóng giữ chỗ">
      <bpmn:incoming>B1_Flow_16</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B1_endExpired" name="Đơn QR hết hạn">
      <bpmn:incoming>B1_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B1_postQr" name="Ghi nhận đã thanh toán QR">
      <bpmn:incoming>B1_Flow_14</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_15</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B1_IO_PaymentEntry" name="PaymentEntry (QR đã trả)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B1_IO_PaymentEntry</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B1_DataAssoc_5"><bpmn:sourceRef>B1_IO_PaymentEntry</bpmn:sourceRef><bpmn:targetRef>B1_Data_PaymentEntry</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B1_confirm" name="Xác nhận đơn">
      <bpmn:incoming>B1_Flow_8</bpmn:incoming>
      <bpmn:incoming>B1_Flow_15</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="B1_pack" name="Lấy và đóng gói hàng">
      <bpmn:incoming>B1_Flow_18</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="B1_shipRequest" name="Gửi yêu cầu tạo vận đơn" messageRef="B1_Message_6">
      <bpmn:incoming>B1_Flow_19</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="B1_tracking" name="Đã nhận mã vận đơn">
      <bpmn:incoming>B1_Flow_20</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B1_EventDef_tracking" messageRef="B1_Message_7"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="B1_handover" name="Bàn giao kiện và ghi xuất kho">
      <bpmn:incoming>B1_Flow_21</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="B1_delivery" name="Đã nhận kết quả giao">
      <bpmn:incoming>B1_Flow_22</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B1_EventDef_delivery" messageRef="B1_Message_8"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="B1_deliveryOk" name="Giao thành công?" default="B1_Flow_25">
      <bpmn:incoming>B1_Flow_23</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_24</bpmn:outgoing>
      <bpmn:outgoing>B1_Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B1_recordGood" name="Ghi đã giao và COD đã thu">
      <bpmn:incoming>B1_Flow_24</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_26</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B1_IO_Shipment" name="Shipment (vận đơn)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B1_IO_Shipment</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B1_DataAssoc_3"><bpmn:sourceRef>B1_IO_Shipment</bpmn:sourceRef><bpmn:targetRef>B1_Data_Shipment</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B1_endGood" name="Đơn đã giao">
      <bpmn:incoming>B1_Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B1_recordBad" name="Ghi lần giao thất bại">
      <bpmn:incoming>B1_Flow_25</bpmn:incoming>
      <bpmn:outgoing>B1_Flow_27</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B1_IO_ShipmentEvent" name="ShipmentEvent (lần giao)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B1_IO_ShipmentEvent</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B1_DataAssoc_4"><bpmn:sourceRef>B1_IO_ShipmentEvent</bpmn:sourceRef><bpmn:targetRef>B1_Data_ShipmentEvent</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B1_endBad" name="Chuyển BPMN-02">
      <bpmn:incoming>B1_Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B1_Flow_1" sourceRef="B1_start" targetRef="B1_validate"/>
    <bpmn:sequenceFlow id="B1_Flow_2" sourceRef="B1_validate" targetRef="B1_reserve"/>
    <bpmn:sequenceFlow id="B1_Flow_3" sourceRef="B1_reserve" targetRef="B1_stockOk"/>
    <bpmn:sequenceFlow id="B1_Flow_4" name="Có" sourceRef="B1_stockOk" targetRef="B1_method"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B1_Flow_5" name="Không" sourceRef="B1_stockOk" targetRef="B1_noStock"/>
    <bpmn:sequenceFlow id="B1_Flow_6" name="COD" sourceRef="B1_method" targetRef="B1_expected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">COD</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B1_Flow_7" name="QR" sourceRef="B1_method" targetRef="B1_requestQr"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">QR</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B1_Flow_8" sourceRef="B1_expected" targetRef="B1_confirm"/>
    <bpmn:sequenceFlow id="B1_Flow_9" sourceRef="B1_requestQr" targetRef="B1_gotQr"/>
    <bpmn:sequenceFlow id="B1_Flow_10" sourceRef="B1_gotQr" targetRef="B1_showQr"/>
    <bpmn:sequenceFlow id="B1_Flow_11" sourceRef="B1_showQr" targetRef="B1_waitQr"/>
    <bpmn:sequenceFlow id="B1_Flow_12" sourceRef="B1_waitQr" targetRef="B1_paid"/>
    <bpmn:sequenceFlow id="B1_Flow_13" sourceRef="B1_waitQr" targetRef="B1_expired"/>
    <bpmn:sequenceFlow id="B1_Flow_14" sourceRef="B1_paid" targetRef="B1_postQr"/>
    <bpmn:sequenceFlow id="B1_Flow_15" sourceRef="B1_postQr" targetRef="B1_confirm"/>
    <bpmn:sequenceFlow id="B1_Flow_16" sourceRef="B1_expired" targetRef="B1_cancel"/>
    <bpmn:sequenceFlow id="B1_Flow_17" sourceRef="B1_cancel" targetRef="B1_endExpired"/>
    <bpmn:sequenceFlow id="B1_Flow_18" sourceRef="B1_confirm" targetRef="B1_pack"/>
    <bpmn:sequenceFlow id="B1_Flow_19" sourceRef="B1_pack" targetRef="B1_shipRequest"/>
    <bpmn:sequenceFlow id="B1_Flow_20" sourceRef="B1_shipRequest" targetRef="B1_tracking"/>
    <bpmn:sequenceFlow id="B1_Flow_21" sourceRef="B1_tracking" targetRef="B1_handover"/>
    <bpmn:sequenceFlow id="B1_Flow_22" sourceRef="B1_handover" targetRef="B1_delivery"/>
    <bpmn:sequenceFlow id="B1_Flow_23" sourceRef="B1_delivery" targetRef="B1_deliveryOk"/>
    <bpmn:sequenceFlow id="B1_Flow_24" name="Có" sourceRef="B1_deliveryOk" targetRef="B1_recordGood"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B1_Flow_25" name="Không" sourceRef="B1_deliveryOk" targetRef="B1_recordBad"/>
    <bpmn:sequenceFlow id="B1_Flow_26" sourceRef="B1_recordGood" targetRef="B1_endGood"/>
    <bpmn:sequenceFlow id="B1_Flow_27" sourceRef="B1_recordBad" targetRef="B1_endBad"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="B1_Diagram" name="BPMN-01 — Đặt đơn, thanh toán và giao hàng">
    <bpmndi:BPMNPlane id="B1_Plane" bpmnElement="B1_Collaboration">
      <bpmndi:BPMNShape id="B1_Di_shop" bpmnElement="B1_shop" isHorizontal="true"><dc:Bounds x="30" y="170" width="3600" height="1324"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_Di_buyer" bpmnElement="B1_buyer" isHorizontal="true"><dc:Bounds x="87" y="48" width="509" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_Di_qr" bpmnElement="B1_qr" isHorizontal="true"><dc:Bounds x="1149" y="48" width="863" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_Di_carrier" bpmnElement="B1_carrier" isHorizontal="true"><dc:Bounds x="2388" y="48" width="1040" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_Di_Lane_order" bpmnElement="B1_Lane_order" isHorizontal="true"><dc:Bounds x="59" y="170" width="3571" height="322"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_Di_Lane_stock" bpmnElement="B1_Lane_stock" isHorizontal="true"><dc:Bounds x="59" y="492" width="3571" height="322"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_Di_Lane_pay" bpmnElement="B1_Lane_pay" isHorizontal="true"><dc:Bounds x="59" y="814" width="3571" height="322"/></bpmndi:BPMNShape>
