<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="B3_Definitions" targetNamespace="https://sme-o2c.example/bpmn" exporter="IT4350 SME O2C">
  <bpmn:message id="B3_Message_1" name="Bảng kê COD theo kỳ"/>
  <bpmn:message id="B3_Message_2" name="Bảng kê giao dịch QR"/>
  <bpmn:message id="B3_Message_3" name="Hóa đơn dịch vụ vận chuyển"/>
  <bpmn:message id="B3_Message_4" name="Xác nhận bảng kê COD theo kỳ"/>
  <bpmn:message id="B3_Message_5" name="Sao kê hoặc thông báo tiền vào"/>
  <bpmn:collaboration id="B3_Collaboration" name="BPMN-03 — Đối soát COD/QR và hóa đơn phí">
    <bpmn:participant id="B3_shop" name="Shop SME" processRef="B3_Process"/>
    <bpmn:participant id="B3_carrier" name="Đơn vị vận chuyển"/>
    <bpmn:participant id="B3_qr" name="Đơn vị cung cấp thanh toán QR"/>
    <bpmn:participant id="B3_bank" name="Ngân hàng nhận tiền của shop"/>
    <bpmn:messageFlow id="B3_MsgFlow_1" name="Bảng kê COD theo kỳ" sourceRef="B3_carrier" targetRef="B3_startCod" messageRef="B3_Message_1"/>
    <bpmn:messageFlow id="B3_MsgFlow_2" name="Bảng kê giao dịch QR" sourceRef="B3_qr" targetRef="B3_startQr" messageRef="B3_Message_2"/>
    <bpmn:messageFlow id="B3_MsgFlow_3" name="Hóa đơn dịch vụ vận chuyển" sourceRef="B3_carrier" targetRef="B3_startInvoice" messageRef="B3_Message_3"/>
    <bpmn:messageFlow id="B3_MsgFlow_4" name="Xác nhận bảng kê COD theo kỳ" sourceRef="B3_confirm" targetRef="B3_carrier" messageRef="B3_Message_4"/>
    <bpmn:messageFlow id="B3_MsgFlow_5" name="Sao kê hoặc thông báo tiền vào" sourceRef="B3_bank" targetRef="B3_gotBank" messageRef="B3_Message_5"/>
  </bpmn:collaboration>
  <bpmn:process id="B3_Process" name="BPMN-03 — Đối soát COD/QR và hóa đơn phí" isExecutable="false">
    <bpmn:laneSet id="B3_LaneSet">
      <bpmn:lane id="B3_Lane_import" name="Tiếp nhận hồ sơ">
        <bpmn:flowNodeRef>B3_startCod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_startQr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_startInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_rejectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_gotBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_saveBank</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B3_Lane_match" name="Đối soát tự động">
        <bpmn:flowNodeRef>B3_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_cod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_codOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_qrCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_qrOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_bankCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_bankOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_matched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B3_Lane_acc" name="Kế toán">
        <bpmn:flowNodeRef>B3_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_invoiceOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_invoicePay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_invoiceEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_updated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3_open</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="B3_Object_Statement" name="Statement/Remittance và sao kê"/>
    <bpmn:dataObjectReference id="B3_Data_Statement" name="Statement/Remittance và sao kê" dataObjectRef="B3_Object_Statement"/>
    <bpmn:dataObject id="B3_Object_CarrierInvoice" name="CarrierInvoice (hóa đơn phí)"/>
    <bpmn:dataObjectReference id="B3_Data_CarrierInvoice" name="CarrierInvoice (hóa đơn phí)" dataObjectRef="B3_Object_CarrierInvoice"/>
    <bpmn:dataObject id="B3_Object_ReconciliationCase" name="ReconciliationCase (khoản lệch)"/>
    <bpmn:dataObjectReference id="B3_Data_ReconciliationCase" name="ReconciliationCase (khoản lệch)" dataObjectRef="B3_Object_ReconciliationCase"/>
    <bpmn:dataObject id="B3_Object_PaymentEntry" name="PaymentEntry (tiền thực nhận)"/>
    <bpmn:dataObjectReference id="B3_Data_PaymentEntry" name="PaymentEntry (tiền thực nhận)" dataObjectRef="B3_Object_PaymentEntry"/>
    <bpmn:startEvent id="B3_startCod" name="Đã nhận bảng kê COD">
      <bpmn:outgoing>B3_Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B3_EventDef_startCod" messageRef="B3_Message_1"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="B3_startQr" name="Đã nhận bảng kê QR">
      <bpmn:outgoing>B3_Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B3_EventDef_startQr" messageRef="B3_Message_2"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="B3_startInvoice" name="Đã nhận hóa đơn vận chuyển">
      <bpmn:outgoing>B3_Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B3_EventDef_startInvoice" messageRef="B3_Message_3"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B3_import" name="Nhập và kiểm tra hồ sơ">
      <bpmn:incoming>B3_Flow_1</bpmn:incoming>
      <bpmn:incoming>B3_Flow_2</bpmn:incoming>
      <bpmn:incoming>B3_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B3_valid" name="Hồ sơ hợp lệ?" default="B3_Flow_6">
      <bpmn:incoming>B3_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B3_reject" name="Ghi lỗi và yêu cầu bổ sung">
      <bpmn:incoming>B3_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="B3_rejectEnd" name="Đã trả hồ sơ lỗi">
      <bpmn:incoming>B3_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="B3_type" name="Loại hồ sơ?">
      <bpmn:incoming>B3_Flow_5</bpmn:incoming>
      <bpmn:incoming>B3_Flow_39</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B3_cod" name="So COD theo đơn với bảng kê">
      <bpmn:incoming>B3_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B3_codOk" name="Bảng kê COD khớp?" default="B3_Flow_13">
      <bpmn:incoming>B3_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="B3_confirm" name="Gửi xác nhận bảng kê COD" messageRef="B3_Message_4">
      <bpmn:incoming>B3_Flow_42</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="B3_qrCheck" name="So giao dịch QR với bảng kê">
      <bpmn:incoming>B3_Flow_9</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B3_qrOk" name="Bảng kê QR khớp?" default="B3_Flow_17">
      <bpmn:incoming>B3_Flow_15</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B3_invoice" name="Kiểm hóa đơn phí theo vận đơn">
      <bpmn:incoming>B3_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_18</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="B3_IO_CarrierInvoice" name="CarrierInvoice (hóa đơn phí)"/>
        <bpmn:inputSet><bpmn:dataInputRefs>B3_IO_CarrierInvoice</bpmn:dataInputRefs></bpmn:inputSet>
        <bpmn:outputSet></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="B3_DataAssoc_2"><bpmn:sourceRef>B3_Data_CarrierInvoice</bpmn:sourceRef><bpmn:targetRef>B3_IO_CarrierInvoice</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B3_invoiceOk" name="Hóa đơn đúng?" default="B3_Flow_20">
      <bpmn:incoming>B3_Flow_18</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B3_invoicePay" name="Duyệt và ghi thanh toán phí riêng">
      <bpmn:incoming>B3_Flow_19</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="B3_invoiceEnd" name="Đã xử lý hóa đơn phí">
      <bpmn:incoming>B3_Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B3_bankCheck" name="Tra chứng từ và hạn tiền về">
      <bpmn:incoming>B3_Flow_14</bpmn:incoming>
      <bpmn:incoming>B3_Flow_16</bpmn:incoming>
      <bpmn:incoming>B3_Flow_30</bpmn:incoming>
      <bpmn:incoming>B3_Flow_40</bpmn:incoming>
      <bpmn:incoming>B3_Flow_41</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B3_bankOk" name="Có chứng từ thực nhận?" default="B3_Flow_24">
      <bpmn:incoming>B3_Flow_22</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_23</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="B3_pending" name="Đã đến hạn chuyển tiền?" default="B3_Flow_26">
      <bpmn:incoming>B3_Flow_24</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_25</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="B3_wait" name="Chờ sao kê hoặc đến hạn">
      <bpmn:incoming>B3_Flow_26</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_27</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_28</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="B3_gotBank" name="Đã nhận sao kê bổ sung">
      <bpmn:incoming>B3_Flow_27</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_29</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B3_EventDef_gotBank" messageRef="B3_Message_5"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="B3_due" name="Đã đến hạn đối soát">
      <bpmn:incoming>B3_Flow_28</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_30</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B3_EventDef_due"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">settlementDueAt</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="B3_compare" name="Kiểm ba nguồn tiền">
      <bpmn:incoming>B3_Flow_23</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_31</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="B3_IO_Statement" name="Statement/Remittance và sao kê"/>
        <bpmn:inputSet><bpmn:dataInputRefs>B3_IO_Statement</bpmn:dataInputRefs></bpmn:inputSet>
        <bpmn:outputSet></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="B3_DataAssoc_1"><bpmn:sourceRef>B3_Data_Statement</bpmn:sourceRef><bpmn:targetRef>B3_IO_Statement</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B3_matched" name="Ba nguồn khớp?" default="B3_Flow_33">
      <bpmn:incoming>B3_Flow_31</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_32</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B3_post" name="Ghi thực nhận và chốt đối soát">
      <bpmn:incoming>B3_Flow_32</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_34</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B3_IO_PaymentEntry" name="PaymentEntry (tiền thực nhận)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B3_IO_PaymentEntry</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B3_DataAssoc_4"><bpmn:sourceRef>B3_IO_PaymentEntry</bpmn:sourceRef><bpmn:targetRef>B3_Data_PaymentEntry</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B3_ok" name="Đã chốt đối soát">
      <bpmn:incoming>B3_Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="B3_case" name="Mở hoặc cập nhật hồ sơ chênh lệch">
      <bpmn:incoming>B3_Flow_13</bpmn:incoming>
      <bpmn:incoming>B3_Flow_17</bpmn:incoming>
      <bpmn:incoming>B3_Flow_20</bpmn:incoming>
      <bpmn:incoming>B3_Flow_25</bpmn:incoming>
      <bpmn:incoming>B3_Flow_33</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_35</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B3_IO_ReconciliationCase" name="ReconciliationCase (khoản lệch)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B3_IO_ReconciliationCase</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B3_DataAssoc_3"><bpmn:sourceRef>B3_IO_ReconciliationCase</bpmn:sourceRef><bpmn:targetRef>B3_Data_ReconciliationCase</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="B3_investigate" name="Xác minh với chứng từ và đối tác">
      <bpmn:incoming>B3_Flow_35</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B3_updated" name="Đủ chứng từ xử lý lại?" default="B3_Flow_38">
      <bpmn:incoming>B3_Flow_36</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_37</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B3_record" name="Lưu chứng từ đã xác minh">
      <bpmn:incoming>B3_Flow_37</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B3_open" name="Còn hồ sơ chênh lệch mở">
      <bpmn:incoming>B3_Flow_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B3_saveBank" name="Lưu thông tin tiền vào theo mã tham chiếu">
      <bpmn:incoming>B3_Flow_29</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B3_confirmed" name="Đã gửi xác nhận cho kỳ này?" default="B3_Flow_42">
      <bpmn:incoming>B3_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B3_Flow_41</bpmn:outgoing>
      <bpmn:outgoing>B3_Flow_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="B3_Flow_1" sourceRef="B3_startCod" targetRef="B3_import"/>
    <bpmn:sequenceFlow id="B3_Flow_2" sourceRef="B3_startQr" targetRef="B3_import"/>
    <bpmn:sequenceFlow id="B3_Flow_3" sourceRef="B3_startInvoice" targetRef="B3_import"/>
    <bpmn:sequenceFlow id="B3_Flow_4" sourceRef="B3_import" targetRef="B3_valid"/>
    <bpmn:sequenceFlow id="B3_Flow_5" name="Có" sourceRef="B3_valid" targetRef="B3_type"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B3_Flow_6" name="Không" sourceRef="B3_valid" targetRef="B3_reject"/>
    <bpmn:sequenceFlow id="B3_Flow_7" sourceRef="B3_reject" targetRef="B3_rejectEnd"/>
    <bpmn:sequenceFlow id="B3_Flow_8" name="Bảng kê COD" sourceRef="B3_type" targetRef="B3_cod"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Bảng kê COD</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B3_Flow_9" name="Bảng kê QR" sourceRef="B3_type" targetRef="B3_qrCheck"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Bảng kê QR</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B3_Flow_10" name="Hóa đơn phí" sourceRef="B3_type" targetRef="B3_invoice"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Hóa đơn phí</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B3_Flow_11" sourceRef="B3_cod" targetRef="B3_codOk"/>
    <bpmn:sequenceFlow id="B3_Flow_12" name="Có" sourceRef="B3_codOk" targetRef="B3_confirmed"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B3_Flow_13" name="Không" sourceRef="B3_codOk" targetRef="B3_case"/>
    <bpmn:sequenceFlow id="B3_Flow_14" sourceRef="B3_confirm" targetRef="B3_bankCheck"/>
    <bpmn:sequenceFlow id="B3_Flow_15" sourceRef="B3_qrCheck" targetRef="B3_qrOk"/>
    <bpmn:sequenceFlow id="B3_Flow_16" name="Có" sourceRef="B3_qrOk" targetRef="B3_bankCheck"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
