<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="B2_Definitions" targetNamespace="https://sme-o2c.example/bpmn" exporter="IT4350 SME O2C">
  <bpmn:message id="B2_Message_1" name="Thông báo giao thất bại hoặc bị từ chối"/>
  <bpmn:message id="B2_Message_2" name="Yêu cầu giao lại"/>
  <bpmn:message id="B2_Message_3" name="Kết quả giao lại"/>
  <bpmn:message id="B2_Message_4" name="Yêu cầu chuyển hoàn"/>
  <bpmn:message id="B2_Message_5" name="Yêu cầu đổi/trả sau giao"/>
  <bpmn:message id="B2_Message_6" name="Hồ sơ RMA và hướng dẫn"/>
  <bpmn:message id="B2_Message_7" name="Yêu cầu hoàn tiền"/>
  <bpmn:message id="B2_Message_8" name="Kết quả hoàn tiền"/>
  <bpmn:collaboration id="B2_Collaboration" name="BPMN-02 — Giao thất bại, chuyển hoàn và đổi/trả">
    <bpmn:participant id="B2_shop" name="Shop SME" processRef="B2_Process"/>
    <bpmn:participant id="B2_buyer" name="Khách hàng"/>
    <bpmn:participant id="B2_carrier" name="Đơn vị vận chuyển"/>
    <bpmn:participant id="B2_qr" name="Đơn vị cung cấp thanh toán QR"/>
    <bpmn:messageFlow id="B2_MsgFlow_1" name="Thông báo giao thất bại hoặc bị từ chối" sourceRef="B2_carrier" targetRef="B2_startFail" messageRef="B2_Message_1"/>
    <bpmn:messageFlow id="B2_MsgFlow_2" name="Yêu cầu giao lại" sourceRef="B2_retry" targetRef="B2_carrier" messageRef="B2_Message_2"/>
    <bpmn:messageFlow id="B2_MsgFlow_3" name="Kết quả giao lại" sourceRef="B2_carrier" targetRef="B2_retryResult" messageRef="B2_Message_3"/>
    <bpmn:messageFlow id="B2_MsgFlow_4" name="Yêu cầu chuyển hoàn" sourceRef="B2_rto" targetRef="B2_carrier" messageRef="B2_Message_4"/>
    <bpmn:messageFlow id="B2_MsgFlow_5" name="Yêu cầu đổi/trả sau giao" sourceRef="B2_buyer" targetRef="B2_startReturn" messageRef="B2_Message_5"/>
    <bpmn:messageFlow id="B2_MsgFlow_6" name="Hồ sơ RMA và hướng dẫn" sourceRef="B2_rma" targetRef="B2_buyer" messageRef="B2_Message_6"/>
    <bpmn:messageFlow id="B2_MsgFlow_7" name="Yêu cầu hoàn tiền" sourceRef="B2_sendRefund" targetRef="B2_qr" messageRef="B2_Message_7"/>
    <bpmn:messageFlow id="B2_MsgFlow_8" name="Kết quả hoàn tiền" sourceRef="B2_qr" targetRef="B2_refundResponse" messageRef="B2_Message_8"/>
  </bpmn:collaboration>
  <bpmn:process id="B2_Process" name="BPMN-02 — Giao thất bại, chuyển hoàn và đổi/trả" isExecutable="false">
    <bpmn:laneSet id="B2_LaneSet">
      <bpmn:lane id="B2_Lane_ship" name="Điều phối và Bán hàng/CSKH">
        <bpmn:flowNodeRef>B2_startFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_retryOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_retryResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_retryDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_retrySuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_retryEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_rto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B2_Lane_returns" name="Xử lý hàng quay về">
        <bpmn:flowNodeRef>B2_startReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_eligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_rejectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_rma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B2_Lane_stock" name="Kho">
        <bpmn:flowNodeRef>B2_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_qcOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_restock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_quarantine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_replacement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B2_Lane_pay" name="Thanh toán và kế toán">
        <bpmn:flowNodeRef>B2_uncoll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_sendRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_refundResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_refundOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_refundRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_codRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2_pending</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="B2_Object_Return" name="Return/RMA (hồ sơ đổi/trả)"/>
    <bpmn:dataObjectReference id="B2_Data_Return" name="Return/RMA (hồ sơ đổi/trả)" dataObjectRef="B2_Object_Return"/>
    <bpmn:dataObject id="B2_Object_StockEntry" name="StockEntry (biến động tồn)"/>
    <bpmn:dataObjectReference id="B2_Data_StockEntry" name="StockEntry (biến động tồn)" dataObjectRef="B2_Object_StockEntry"/>
    <bpmn:dataObject id="B2_Object_ShipmentEvent" name="ShipmentEvent (lần giao)"/>
    <bpmn:dataObjectReference id="B2_Data_ShipmentEvent" name="ShipmentEvent (lần giao)" dataObjectRef="B2_Object_ShipmentEvent"/>
    <bpmn:dataObject id="B2_Object_PaymentEntry" name="PaymentEntry (tiền hoàn)"/>
    <bpmn:dataObjectReference id="B2_Data_PaymentEntry" name="PaymentEntry (tiền hoàn)" dataObjectRef="B2_Object_PaymentEntry"/>
    <bpmn:startEvent id="B2_startFail" name="Đã nhận lần giao thất bại">
      <bpmn:outgoing>B2_Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B2_EventDef_startFail" messageRef="B2_Message_1"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B2_record" name="Ghi hoặc tra ShipmentEvent">
      <bpmn:incoming>B2_Flow_1</bpmn:incoming>
      <bpmn:incoming>B2_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_2</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="B2_IO_ShipmentEvent" name="ShipmentEvent (lần giao)"/>
        <bpmn:inputSet><bpmn:dataInputRefs>B2_IO_ShipmentEvent</bpmn:dataInputRefs></bpmn:inputSet>
        <bpmn:outputSet></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="B2_DataAssoc_3"><bpmn:sourceRef>B2_Data_ShipmentEvent</bpmn:sourceRef><bpmn:targetRef>B2_IO_ShipmentEvent</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B2_retryOk" name="Còn lượt và khách đồng ý?" default="B2_Flow_4">
      <bpmn:incoming>B2_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="B2_retry" name="Yêu cầu giao lại" messageRef="B2_Message_2">
      <bpmn:incoming>B2_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="B2_retryResult" name="Đã nhận kết quả giao lại">
      <bpmn:incoming>B2_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B2_EventDef_retryResult" messageRef="B2_Message_3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="B2_retryDone" name="Giao lại thành công?" default="B2_Flow_7">
      <bpmn:incoming>B2_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B2_retrySuccess" name="Ghi đã giao và COD đã thu nếu có">
      <bpmn:incoming>B2_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B2_retryEnd" name="Giao lại thành công">
      <bpmn:incoming>B2_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="B2_rto" name="Yêu cầu chuyển hoàn" messageRef="B2_Message_4">
      <bpmn:incoming>B2_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="B2_startReturn" name="Đã nhận yêu cầu đổi/trả">
      <bpmn:outgoing>B2_Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B2_EventDef_startReturn" messageRef="B2_Message_5"/>
    </bpmn:startEvent>
    <bpmn:userTask id="B2_eligibility" name="Kiểm tra điều kiện đổi/trả">
      <bpmn:incoming>B2_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B2_eligible" name="Yêu cầu hợp lệ?" default="B2_Flow_14">
      <bpmn:incoming>B2_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B2_reject" name="Ghi lý do và báo khách">
      <bpmn:incoming>B2_Flow_14</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="B2_rejectEnd" name="Yêu cầu bị từ chối">
      <bpmn:incoming>B2_Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="B2_rma" name="Lập RMA và gửi hướng dẫn" messageRef="B2_Message_6">
      <bpmn:incoming>B2_Flow_13</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_16</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B2_IO_Return" name="Return/RMA (hồ sơ đổi/trả)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B2_IO_Return</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B2_DataAssoc_1"><bpmn:sourceRef>B2_IO_Return</bpmn:sourceRef><bpmn:targetRef>B2_Data_Return</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:manualTask id="B2_receive" name="Thực nhận và đối chiếu mã kiện">
      <bpmn:incoming>B2_Flow_10</bpmn:incoming>
      <bpmn:incoming>B2_Flow_16</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="B2_qc" name="Kiểm chất lượng hàng">
      <bpmn:incoming>B2_Flow_17</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="B2_qcOk" name="Bán lại được?" default="B2_Flow_20">
      <bpmn:incoming>B2_Flow_18</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B2_restock" name="Ghi nhập lại hàng có thể bán">
      <bpmn:incoming>B2_Flow_19</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_21</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B2_IO_StockEntry" name="StockEntry (biến động tồn)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B2_IO_StockEntry</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B2_DataAssoc_2"><bpmn:sourceRef>B2_IO_StockEntry</bpmn:sourceRef><bpmn:targetRef>B2_Data_StockEntry</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B2_quarantine" name="Ghi đưa hàng vào khu cách ly">
      <bpmn:incoming>B2_Flow_20</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="B2_decision" name="Xác định hướng xử lý được duyệt">
      <bpmn:incoming>B2_Flow_21</bpmn:incoming>
      <bpmn:incoming>B2_Flow_22</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B2_action" name="Hướng xử lý?" default="B2_Flow_28">
      <bpmn:incoming>B2_Flow_23</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_24</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_25</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_26</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_27</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B2_uncoll" name="Ghi COD chưa thu">
      <bpmn:incoming>B2_Flow_24</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B2_replacement" name="Giữ hàng thay thế và lập vận đơn">
      <bpmn:incoming>B2_Flow_25</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B2_sendRefund" name="Gửi yêu cầu hoàn QR" messageRef="B2_Message_7">
      <bpmn:incoming>B2_Flow_26</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="B2_refundResponse" name="Đã nhận kết quả hoàn QR">
      <bpmn:incoming>B2_Flow_29</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B2_EventDef_refundResponse" messageRef="B2_Message_8"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="B2_refundOk" name="Hoàn tiền thành công?" default="B2_Flow_32">
      <bpmn:incoming>B2_Flow_30</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_31</bpmn:outgoing>
      <bpmn:outgoing>B2_Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B2_refundRecord" name="Ghi khoản hoàn QR">
      <bpmn:incoming>B2_Flow_31</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_33</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="B2_IO_PaymentEntry" name="PaymentEntry (tiền hoàn)"/>
        <bpmn:inputSet></bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>B2_IO_PaymentEntry</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="B2_DataAssoc_4"><bpmn:sourceRef>B2_IO_PaymentEntry</bpmn:sourceRef><bpmn:targetRef>B2_Data_PaymentEntry</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="B2_codRefund" name="Hoàn COD và ghi chứng từ chi">
      <bpmn:incoming>B2_Flow_27</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="B2_verify" name="Mở hồ sơ cần xác minh">
      <bpmn:incoming>B2_Flow_28</bpmn:incoming>
      <bpmn:incoming>B2_Flow_32</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="B2_pending" name="Đã chuyển kế toán xác minh">
      <bpmn:incoming>B2_Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B2_close" name="Đóng hồ sơ hàng quay về">
      <bpmn:incoming>B2_Flow_33</bpmn:incoming>
      <bpmn:incoming>B2_Flow_34</bpmn:incoming>
      <bpmn:incoming>B2_Flow_35</bpmn:incoming>
      <bpmn:incoming>B2_Flow_36</bpmn:incoming>
      <bpmn:outgoing>B2_Flow_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B2_end" name="Đã xử lý hàng quay về">
      <bpmn:incoming>B2_Flow_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B2_Flow_1" sourceRef="B2_startFail" targetRef="B2_record"/>
    <bpmn:sequenceFlow id="B2_Flow_2" sourceRef="B2_record" targetRef="B2_retryOk"/>
    <bpmn:sequenceFlow id="B2_Flow_3" name="Có" sourceRef="B2_retryOk" targetRef="B2_retry"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B2_Flow_4" name="Không" sourceRef="B2_retryOk" targetRef="B2_rto"/>
    <bpmn:sequenceFlow id="B2_Flow_5" sourceRef="B2_retry" targetRef="B2_retryResult"/>
    <bpmn:sequenceFlow id="B2_Flow_6" sourceRef="B2_retryResult" targetRef="B2_retryDone"/>
    <bpmn:sequenceFlow id="B2_Flow_7" name="Không" sourceRef="B2_retryDone" targetRef="B2_record"/>
    <bpmn:sequenceFlow id="B2_Flow_8" name="Có" sourceRef="B2_retryDone" targetRef="B2_retrySuccess"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B2_Flow_9" sourceRef="B2_retrySuccess" targetRef="B2_retryEnd"/>
    <bpmn:sequenceFlow id="B2_Flow_10" sourceRef="B2_rto" targetRef="B2_receive"/>
    <bpmn:sequenceFlow id="B2_Flow_11" sourceRef="B2_startReturn" targetRef="B2_eligibility"/>
    <bpmn:sequenceFlow id="B2_Flow_12" sourceRef="B2_eligibility" targetRef="B2_eligible"/>
    <bpmn:sequenceFlow id="B2_Flow_13" name="Có" sourceRef="B2_eligible" targetRef="B2_rma"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B2_Flow_14" name="Không" sourceRef="B2_eligible" targetRef="B2_reject"/>
    <bpmn:sequenceFlow id="B2_Flow_15" sourceRef="B2_reject" targetRef="B2_rejectEnd"/>
    <bpmn:sequenceFlow id="B2_Flow_16" sourceRef="B2_rma" targetRef="B2_receive"/>
    <bpmn:sequenceFlow id="B2_Flow_17" sourceRef="B2_receive" targetRef="B2_qc"/>
    <bpmn:sequenceFlow id="B2_Flow_18" sourceRef="B2_qc" targetRef="B2_qcOk"/>
    <bpmn:sequenceFlow id="B2_Flow_19" name="Có" sourceRef="B2_qcOk" targetRef="B2_restock"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B2_Flow_20" name="Không" sourceRef="B2_qcOk" targetRef="B2_quarantine"/>
    <bpmn:sequenceFlow id="B2_Flow_21" sourceRef="B2_restock" targetRef="B2_decision"/>
