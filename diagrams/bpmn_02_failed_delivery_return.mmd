    n_retryDone -->|Không| n_record
    n_retryDone -->|Có| n_retrySuccess
    n_retrySuccess --> n_retryEnd
    n_rto --> n_receive
    n_startReturn --> n_eligibility
    n_eligibility --> n_eligible
    n_eligible -->|Có| n_rma
    n_eligible -->|Không| n_reject
    n_reject --> n_rejectEnd
    n_rma --> n_receive
    n_receive --> n_qc
